# 바이너리 힌트 (git 의 heuristic 보강)
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.docx binary
*.xlsx binary
*.pptx binary

# 텍스트 라인엔딩 (Windows/WSL/Unix 혼용 대비)
