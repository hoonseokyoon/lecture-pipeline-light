# Gemini API key (이미지 중심 슬라이드 Vision 보강용)
# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=your_api_key_here

# Gemini on-demand key (doc_decode / md_to_handout: 이미지·long-context heavy 작업용)
# 별도 결제 프로필/쿼터를 분리하고 싶을 때 사용. 미설정이면 GEMINI_API_KEY 로 fallback.
GEMINI_API_KEY_ON_DEMAND=

# Mistral API key (doc_to_md 스킬: PDF → Markdown OCR)
# https://console.mistral.ai/ 에서 발급
MISTRAL_API_KEY=your_api_key_here

# Semantic Scholar API key (lit_search: rate limit 완화, 선택)
# https://www.semanticscholar.org/product/api#api-key-form 에서 신청
SEMANTIC_SCHOLAR_API_KEY=

# NCBI / PubMed (lit_search: 생의학 검색, 선택)
# 무키로도 3 req/s 가능. 이메일 설정 시 NCBI 가 연락 가능해져 rate limit 관대해짐
NCBI_EMAIL=
# API key 있으면 10 req/s (https://www.ncbi.nlm.nih.gov/account/settings/)
PUBMED_API_KEY=
